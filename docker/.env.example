# Copy this file to .env in the ROOT of the project (not inside docker/)
# and fill in your values. The .env file is gitignored.

# Kafka
KAFKA_BROKER_ID=1
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk   # generate with: kafka-storage.sh random-uuid
KAFKA_ADVERTISED_HOST=localhost

# Kafka UI
KAFKA_UI_PORT=8085

# App ports
PRODUCER_PORT=8080
CONSUMER_PORT=8081